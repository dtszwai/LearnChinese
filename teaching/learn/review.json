          "hku-narrative",
          "edb-yueyang"
        ],
        "rationale": "有明確主線、中斷及接回，符合插敘。",
        "acceptedAnswers": [
          "插敘",
          "插敘法",
          "插敍"
        ]
      },
      {
        "stepId": "narrative-return-to-main",
