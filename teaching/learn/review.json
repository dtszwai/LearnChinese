    "narrative": [
      {
        "stepId": "narrative-intro",
        "sources": [
          "edb-learning",
          "hku-narrative",
          "edb-yueyang"
        ],
        "rationale": "事件發生的先後，與作者寫出來的先後，可以不同。本課先練習順敘、倒敘、插敘，再學過渡、照應、伏筆與鋪墊。\\n判斷記敘次序要看一段或全文的安排，不能只看「昨天」「回想」等字眼。"
      },
      {
        "stepId": "narrative-chronological-demo",
        "sources": [
          "edb-learning",
          "hku-narrative",
          "edb-yueyang"
        ],
        "rationale": "三個階段按時間先後排列。",
